<plugin>

<!-- Terminal connector contributions -->
   <extension point="io.github.insjang.terminal.control.connectors">
      <connector
            name="%SshConnector.label"
            id="io.github.insjang.terminal.connector.ssh.SshConnector"
            class="io.github.insjang.terminal.connector.ssh.connector.SshConnector"/>
   </extension>

<!-- Terminal launcher delegate contributions -->
   <extension point="io.github.insjang.terminal.view.ui.launcherDelegates">
      <delegate
            class="io.github.insjang.terminal.connector.ssh.launcher.SshLauncherDelegate"
            id="io.github.insjang.terminal.connector.ssh.launcher.ssh"
            label="%SshLauncherDelegate.label">
            <enablement>
               <with variable="selection">
                  <count value="1"/>
                  <iterate operator="and" ifEmpty="false">
                     <test
                           forcePluginActivation="true"
                           property="io.github.insjang.terminal.view.core.hasContextPropertiesProvider"
                           value="true"/>
                  </iterate>
               </with>
            </enablement>
      </delegate>
   </extension>
<!-- SFTP view on the session of the selected SSH terminal -->
   <extension point="org.eclipse.ui.views">
      <view
            category="io.github.insjang.terminal.view.ui.views.category"
            class="io.github.insjang.terminal.connector.ssh.sftp.FilesView"
            icon="icons/eview16/files_view.svg"
            id="io.github.insjang.terminal.connector.ssh.FilesView"
            name="%FilesView.name">
      </view>
   </extension>
<!-- Edit Session... in the context menu of an SSH terminal (none on other tabs) -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:io.github.insjang.terminal.view.ui.TerminalsView?before=additions">
         <dynamic
               class="io.github.insjang.terminal.connector.ssh.launcher.EditSessionContribution"
               id="io.github.insjang.terminal.connector.ssh.editSession">
         </dynamic>
      </menuContribution>
   </extension>
</plugin>
