   org.eclipse.swt.widgets,
   io.github.insjang.terminal.control",
 io.github.insjang.terminal.connector.provider;version="1.0.100";uses:="io.github.insjang.terminal.connector",
 io.github.insjang.terminal.control;version="1.1.0";
  uses:="org.eclipse.swt.dnd,
   org.eclipse.swt.graphics,
   org.eclipse.swt.widgets,
   io.github.insjang.terminal.connector,
   io.github.insjang.terminal.model",
 io.github.insjang.terminal.internal.connector;x-internal:=true,
 io.github.insjang.terminal.internal.control.impl;x-internal:=true;x-friends:="io.github.insjang.terminal.view.ui",
